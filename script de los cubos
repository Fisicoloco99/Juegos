init python:
    # 1. Definimos la función que leerá las coordenadas
    def al_soltar_rosa(drags, drop):
        if drags:
            # Obtenemos el primer objeto arrastrado
            objeto = drags[0]
            # Guardamos sus coordenadas x e y en variables de Ren'Py
            store.pos_x_rosa = objeto.x
            store.pos_y_rosa = objeto.y
            
            # (Opcional) Muestra las coordenadas en la consola de desarrollo (Shift+D)
            print(f"Objeto {objeto.drag_name} en: X={objeto.x}, Y={objeto.y}")
        return

